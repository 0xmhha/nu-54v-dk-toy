{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nu-wallet:contracts:draft:1",
  "title": "Proposed shared data shapes; not cryptographic or authorization validation",
  "$defs": {
    "Asset": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "chainId": {
          "const": 8283
        },
        "kind": {
          "type": "string",
          "enum": [
            "native",
            "erc20"
          ]
        },
        "tokenAddress": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "displaySymbol": {
          "type": "string",
          "minLength": 1
        },
        "isTestAsset": {
          "type": "boolean"
        }
      },
      "required": [
        "assetId",
        "chainId",
        "kind",
        "tokenAddress",
        "decimals",
        "displaySymbol",
        "isTestAsset"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "native"
              }
            }
          },
          "then": {
            "properties": {
              "tokenAddress": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "tokenAddress": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              }
            }
          }
        }
      ]
    },
    "Money": {
      "type": "object",
      "properties": {
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "atomicAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        }
      },
      "required": [
        "assetId",
        "atomicAmount"
      ],
      "additionalProperties": false
    },
    "Error": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "retryable": {
          "type": "boolean"
        },
        "operationId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "safeMessage": {
          "type": "string",
          "minLength": 1
        },
        "nextAction": {
          "type": "string",
          "enum": [
            "retry_query",
            "reauthenticate",
            "review_again",
            "resolve_balance",
            "wait",
            "contact_support",
            "none"
          ]
        }
      },
      "required": [
        "code",
        "retryable",
        "operationId",
        "safeMessage",
        "nextAction"
      ],
      "additionalProperties": false
    },
    "ChainObservation": {
      "type": "object",
      "properties": {
        "chainId": {
          "const": 8283
        },
        "txHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "blockHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "blockNumber": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "logIndex": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "receiptStatus": {
          "type": "string",
          "enum": [
            "success",
            "reverted"
          ]
        },
        "canonicality": {
          "type": "string",
          "enum": [
            "canonical",
            "orphaned",
            "unknown"
          ]
        },
        "confirmation": {
          "type": "string",
          "enum": [
            "observed",
            "policy_satisfied",
            "pending"
          ]
        },
        "policyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "observationKind": {
          "enum": [
            "transaction",
            "erc20_log"
          ]
        }
      },
      "required": [
        "chainId",
        "txHash",
        "blockHash",
        "blockNumber",
        "logIndex",
        "receiptStatus",
        "canonicality",
        "confirmation",
        "policyId",
        "revision",
        "observedAt",
        "observationKind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "observationKind": {
                "const": "transaction"
              }
            }
          },
          "then": {
            "properties": {
              "logIndex": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "logIndex": {
                "type": "integer",
                "minimum": 0
              },
              "receiptStatus": {
                "const": "success"
              }
            }
          }
        }
      ]
    },
    "PaymentBinding": {
      "type": "object",
      "properties": {
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "intentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "orderId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "payerAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "recipientAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "atomicAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "signedTransactionHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "required": [
        "attemptId",
        "intentId",
        "orderId",
        "sessionId",
        "payerAddress",
        "recipientAddress",
        "assetId",
        "atomicAmount",
        "payloadDigest",
        "signedTransactionHash"
      ],
      "additionalProperties": false
    },
    "Operation": {
      "type": "object",
      "properties": {
        "operationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "unknown",
            "cancelled"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "resultRef": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/Error"
            },
            {
              "type": "null"
            }
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "operationId",
        "kind",
        "state",
        "revision",
        "resultRef",
        "error",
        "updatedAt"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "DomainEvent": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "const": "1"
        },
        "aggregateType": {
          "type": "string",
          "minLength": 1
        },
        "aggregateId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "aggregateRevision": {
          "type": "integer",
          "minimum": 0
        },
        "occurredAt": {
          "type": "string",
          "format": "date-time"
        },
        "correlationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "causationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "eventId",
        "type",
        "schemaVersion",
        "aggregateType",
        "aggregateId",
        "aggregateRevision",
        "occurredAt",
        "correlationId",
        "causationId",
        "payload"
      ],
      "additionalProperties": false
    },
    "RecordingMetadata": {
      "type": "object",
      "properties": {
        "recordingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "formatProfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sampleRateHz": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "completeness": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        },
        "lastSequence": {
          "type": "integer",
          "minimum": 0
        },
        "missingRanges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 0
              },
              "to": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "recordingId",
        "formatProfile",
        "sampleRateHz",
        "channels",
        "completeness",
        "lastSequence",
        "missingRanges"
      ],
      "additionalProperties": false
    },
    "TravelEvidence": {
      "type": "object",
      "properties": {
        "evidenceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sourceType": {
          "type": "string",
          "enum": [
            "location_visit",
            "testnet_payment",
            "commercial_purchase",
            "user_report"
          ]
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "placeId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "consentRevision": {
          "type": "integer",
          "minimum": 0
        },
        "validity": {
          "type": "string",
          "enum": [
            "pending",
            "valid",
            "invalidated",
            "unknown"
          ]
        }
      },
      "required": [
        "evidenceId",
        "sourceType",
        "sourceId",
        "placeId",
        "observedAt",
        "consentRevision",
        "validity"
      ],
      "additionalProperties": false
    },
    "RefundReservation": {
      "type": "object",
      "properties": {
        "refundId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "paymentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "amount": {
          "$ref": "#/$defs/Money"
        },
        "destinationAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "destinationProofRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "reserved",
            "signing",
            "submitted",
            "unknown",
            "confirmed",
            "released"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "refundId",
        "paymentId",
        "amount",
        "destinationAddress",
        "destinationProofRef",
        "state",
        "revision"
      ],
      "additionalProperties": false
    },
    "SignedReleaseManifest": {
      "type": "object",
      "properties": {
        "releaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "firmwareVersion": {
          "type": "string",
          "minLength": 1
        },
        "packageSize": {
          "type": "integer",
          "minimum": 1
        },
        "packageHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "compatibilityProfile": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "signingKeyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "signatureRef": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "releaseId",
        "model",
        "firmwareVersion",
        "packageSize",
        "packageHash",
        "compatibilityProfile",
        "signingKeyId",
        "signatureRef"
      ],
      "additionalProperties": false
    },
    "BleControlMessage": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "draft-1"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sessionRole": {
          "type": "string",
          "enum": [
            "owner",
            "payment_terminal",
            "ranging_peer"
          ]
        },
        "messageId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sequence": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "type": "string",
          "enum": [
            "request",
            "response",
            "event"
          ]
        },
        "command": {
          "type": "string",
          "enum": [
            "session.close",
            "wallet.create",
            "wallet.import.begin",
            "wallet.import.chunk",
            "wallet.import.commit",
            "wallet.import.abort",
            "wallet.address",
            "device.settings.update",
            "payment.prepare",
            "payment.result",
            "wallet.sign.prepare",
            "wallet.sign.result",
            "request.cancel",
            "proximity.observe",
            "recording.start",
            "recording.stop",
            "audio.flow-control",
            "find.start",
            "find.stop",
            "passport.sync",
            "fota.begin",
            "fota.chunk",
            "fota.finalize",
            "fota.apply",
            "fota.status",
            "credentials.list",
            "credentials.delete",
            "device.reset.prepare",
            "device.reset.confirm",
            "payment.identify"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "protocolVersion",
        "sessionId",
        "sessionRole",
        "messageId",
        "sequence",
        "kind",
        "command",
        "payload"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "sessionRole": {
                "const": "owner"
              }
            }
          },
          "then": {
            "properties": {
              "command": {
                "enum": [
                  "session.close",
                  "wallet.create",
                  "wallet.import.begin",
                  "wallet.import.chunk",
                  "wallet.import.commit",
                  "wallet.import.abort",
                  "wallet.address",
                  "device.settings.update",
                  "wallet.sign.prepare",
                  "wallet.sign.result",
                  "request.cancel",
                  "recording.start",
                  "recording.stop",
                  "audio.flow-control",
                  "find.start",
                  "find.stop",
                  "passport.sync",
                  "fota.begin",
                  "fota.chunk",
                  "fota.finalize",
                  "fota.apply",
                  "fota.status",
                  "credentials.list",
                  "credentials.delete",
                  "device.reset.prepare",
                  "device.reset.confirm"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sessionRole": {
                "const": "payment_terminal"
              }
            }
          },
          "then": {
            "properties": {
              "command": {
                "enum": [
                  "session.close",
                  "payment.identify",
                  "payment.prepare",
                  "payment.result",
                  "request.cancel"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "sessionRole": {
                "const": "ranging_peer"
              }
            }
          },
          "then": {
            "properties": {
              "command": {
                "enum": [
                  "proximity.observe"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "command": {
                "const": "payment.prepare"
              },
              "kind": {
                "const": "request"
              }
            }
          },
          "then": {
            "properties": {
              "payload": {
                "$ref": "#/$defs/PaymentPrepare"
              }
            }
          }
        }
      ]
    },
    "EoaTokenIntent": {
      "type": "object",
      "properties": {
        "intentId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "chainId": {
          "const": 8283
        },
        "payerAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "recipientAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "asset": {
          "allOf": [
            {
              "$ref": "#/$defs/Asset"
            },
            {
              "properties": {
                "kind": {
                  "const": "erc20"
                }
              }
            }
          ]
        },
        "atomicAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "payloadDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "encodingProfile": {
          "type": "string",
          "minLength": 1
        },
        "transaction": {
          "type": "object",
          "properties": {
            "to": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "value": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "data": {
              "type": "string",
              "pattern": "^0x([0-9a-fA-F]{2})*$"
            },
            "nonce": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "gasLimit": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            },
            "feeParameters": {
              "type": "object"
            }
          },
          "required": [
            "to",
            "value",
            "data",
            "nonce",
            "gasLimit",
            "feeParameters"
          ],
          "additionalProperties": false
        },
        "merchantDisplay": {
          "type": "object",
          "properties": {
            "storeId": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "storeId",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "intentId",
        "attemptId",
        "chainId",
        "payerAddress",
        "recipientAddress",
        "asset",
        "atomicAmount",
        "expiresAt",
        "payloadDigest",
        "encodingProfile",
        "transaction",
        "merchantDisplay"
      ],
      "additionalProperties": false
    },
    "PaymentPrepare": {
      "type": "object",
      "properties": {
        "attemptId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "intent": {
          "$ref": "#/$defs/EoaTokenIntent"
        },
        "merchantProofRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "proximityRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "attemptId",
        "intent",
        "merchantProofRef",
        "proximityRef"
      ],
      "additionalProperties": false
    },
    "ResetClearance": {
      "type": "object",
      "properties": {
        "clearanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "rentalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "bindingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "walletOrigin": {
          "enum": [
            "new_travel",
            "imported"
          ]
        },
        "checklistRevision": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "challenge": {
