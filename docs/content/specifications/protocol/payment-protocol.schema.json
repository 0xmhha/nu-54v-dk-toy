{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nu54v-dk/payment-protocol/v1",
  "title": "NU-54V-DK payment protocol v1",
  "description": "Normative types for DF-20260925-02. BLE payloads are deterministic CBOR maps with exactly these keys; EIP-712 types are the only structures the device signs. Prose rules live in payment-protocol.md.",
  "protocolVersion": 1,
  "eip712Domain": [
    {
      "name": "name",
      "type": "string",
      "const": "NU54 Payment Settlement"
    },
    {
      "name": "version",
      "type": "string",
      "const": "1"
    },
    {
      "name": "chainId",
      "type": "uint256",
      "const": 8283
    },
    {
      "name": "verifyingContract",
      "type": "address"
    }
  ],
  "eip712Types": {
    "PaymentAuthorization": [
      {
        "name": "chainId",
        "type": "uint256"
      },
      {
        "name": "contract",
        "type": "address"
      },
      {
        "name": "merchant",
        "type": "address"
      },
      {
        "name": "payout",
        "type": "address"
      },
      {
        "name": "token",
        "type": "address"
      },
      {
        "name": "amount",
        "type": "uint256"
      },
      {
        "name": "orderId",
        "type": "bytes32"
      },
      {
        "name": "nonce",
        "type": "uint256"
      },
      {
        "name": "expiry",
        "type": "uint64"
      }
    ],
    "LimitChange": [
      {
        "name": "chainId",
        "type": "uint256"
      },
      {
        "name": "contract",
        "type": "address"
      },
      {
        "name": "perPaymentLimit",
        "type": "uint256"
      },
      {
        "name": "dailyLimit",
        "type": "uint256"
      },
      {
        "name": "nonce",
        "type": "uint256"
      },
      {
        "name": "expiry",
        "type": "uint64"
      }
    ]
  },
  "operatorSignedTypes": {
    "MerchantAttestation": [
      {
        "name": "merchant",
        "type": "address"
      },
      {
        "name": "payout",
        "type": "address"
      },
      {
        "name": "name",
        "type": "string"
      },
      {
        "name": "validFrom",
        "type": "uint64"
      },
      {
        "name": "validUntil",
        "type": "uint64"
      }
    ],
    "MerchantOrder": [
      {
        "name": "orderId",
        "type": "bytes32"
      },
      {
        "name": "token",
        "type": "address"
      },
      {
        "name": "amount",
        "type": "uint256"
      },
      {
        "name": "payout",
        "type": "address"
      },
      {
        "name": "expiry",
        "type": "uint64"
      }
    ],
    "TimeAnchor": [
      {
        "name": "device",
        "type": "address"
      },
      {
        "name": "timestamp",
        "type": "uint64"
      }
    ],
    "DeviceReset": [
      {
        "name": "device",
        "type": "address"
      },
      {
        "name": "nonce",
        "type": "uint256"
      }
    ]
  },
  "outcomes": [
    "approved",
    "refused",
    "failed",
    "Checking"
  ],
  "gatt": {
    "service": "6e753534-7061-7900-8000-00805f9b0001",
    "characteristics": {
      "rx": {
        "uuid": "6e753534-7061-7900-8000-00805f9b0002",
        "properties": [
          "write"
        ],
        "direction": "central (kiosk, phone app, operator tool) to device"
      },
      "tx": {
        "uuid": "6e753534-7061-7900-8000-00805f9b0003",
        "properties": [
          "notify"
        ],
        "direction": "device to central"
      }
    },
    "security": "payment sessions are accepted on an unpaired link (application-layer secure channel from week 8-9); setup sessions and confirm.show require a bonded LE Secure Connections Passkey Entry link"
  },
  "framing": {
    "envelope": "length u16 big-endian | digest 8 bytes (SHA-256 prefix of the CBOR body) | CBOR body; length is the whole envelope including the 10-byte header (10..2058)",
    "fragment": "sequence u8 | index u8 | envelope bytes up to negotiated ATT_MTU - 5",
    "maxBodyBytes": 2048,
    "cborMapping": {
      "ordering": "RFC 8949 4.2.1 core deterministic: map keys sorted by their encoded bytes; shortest-form integers and lengths",
      "hex20": "byte string, 20 bytes",
      "hex32": "byte string, 32 bytes",
      "signature": "byte string, 65 bytes: r || s || v (27 or 28)",
      "sessionId": "byte string, 8 bytes",
      "uint": "unsigned integer below 2^64, otherwise tag 2 bignum without leading zero bytes",
      "text": "text string (UTF-8)",
      "forbidden": "indefinite lengths, floats, tags other than 2, duplicate or unknown keys; receivers reply BAD_FRAME"
    }
  },
  "$defs": {
    "hex20": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "hex32": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    },
    "signature": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{130}$"
    },
    "uint": {
      "type": "string",
      "pattern": "^[0-9]{1,78}$",
      "description": "decimal string; CBOR carries it as an unsigned integer or bignum"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "reason": {
      "enum": [
        "ATTESTATION_EXPIRED",
        "MERCHANT_REVOKED",
        "OVER_CAP",
        "NONCE_REPLAYED",
        "MERCHANT_FORGED",
        "USER_REJECTED",
        "TIME_ANCHOR_MISSING",
        "UNSUPPORTED_TYPE",
        "BAD_FRAME",
        "TIMEOUT",
        "CANCELLED",
        "PIN_LOCKED",
        "NOT_PERMITTED",
        "EXPIRED",
        "WRONG_DOMAIN",
        "ACCOUNT_INACTIVE",
        "INSUFFICIENT_BALANCE"
      ]
    },
    "signedAttestation": {
      "type": "object",
      "required": [
        "merchant",
        "payout",
        "name",
        "validFrom",
        "validUntil",
        "operatorSignature"
      ],
      "additionalProperties": false,
      "properties": {
        "merchant": {
          "$ref": "#/$defs/hex20"
        },
        "payout": {
          "$ref": "#/$defs/hex20"
        },
        "name": {
          "type": "string",
          "maxLength": 32
        },
        "validFrom": {
          "$ref": "#/$defs/uint"
        },
        "validUntil": {
          "$ref": "#/$defs/uint"
        },
        "operatorSignature": {
          "$ref": "#/$defs/signature"
        }
      }
    }
  },
  "messages": {
    "session.open": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "kioskNonce",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "session.open"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "kioskNonce": {
          "$ref": "#/$defs/hex32"
        },
        "mode": {
          "enum": [
            "payment",
            "setup"
          ]
        }
      }
    },
    "session.open.ok": {
      "direction": "device to kiosk",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "deviceNonce",
        "anchorValid",
        "firmware",
        "state"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "session.open.ok"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "device": {
          "$ref": "#/$defs/hex20",
          "description": "absent in UNPROVISIONED (no key yet); present in every other state"
        },
        "deviceNonce": {
          "$ref": "#/$defs/hex32"
        },
        "anchorValid": {
          "type": "boolean"
        },
        "firmware": {
          "type": "string",
          "maxLength": 32
        },
        "state": {
          "enum": [
            "UNPROVISIONED",
            "PROVISIONED_NO_ANCHOR",
            "READY",
            "PIN_LOCKED"
          ]
        },
        "lastAnchor": {
          "$ref": "#/$defs/uint",
          "description": "timestamp of the last accepted TimeAnchor, 0 if none"
        }
      }
    },
    "session.confirm": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "deviceNonce"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "session.confirm"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "deviceNonce": {
          "$ref": "#/$defs/hex32"
        }
      }
    },
    "payment.identify": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "attestation"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "payment.identify"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "attestation": {
          "$ref": "#/$defs/signedAttestation"
        }
      }
    },
    "payment.prepare": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "authorization",
        "merchantSignature"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "payment.prepare"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "authorization": {
          "type": "object",
          "required": [
            "chainId",
            "contract",
            "merchant",
            "payout",
            "token",
            "amount",
            "orderId",
            "expiry"
          ],
          "additionalProperties": false,
          "properties": {
            "chainId": {
              "$ref": "#/$defs/uint"
            },
            "contract": {
              "$ref": "#/$defs/hex20"
            },
            "merchant": {
              "$ref": "#/$defs/hex20"
            },
            "payout": {
              "$ref": "#/$defs/hex20"
            },
            "token": {
              "$ref": "#/$defs/hex20"
            },
            "amount": {
              "$ref": "#/$defs/uint"
            },
            "orderId": {
              "$ref": "#/$defs/hex32"
            },
            "expiry": {
              "$ref": "#/$defs/uint"
            }
          },
          "description": "PaymentAuthorization without nonce; the device chooses the nonce and returns it in payment.result"
        },
        "merchantSignature": {
          "$ref": "#/$defs/signature",
          "description": "merchant signing key over MerchantOrder"
        }
      }
    },
    "payment.result": {
      "direction": "device to kiosk",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "payment.result"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "outcome": {
          "enum": [
            "approved",
            "refused"
          ]
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "nonce": {
          "$ref": "#/$defs/uint"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "signature",
              "nonce"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "refused"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "limit.change": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "change"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "limit.change"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "change": {
          "type": "object",
          "required": [
            "chainId",
            "contract",
            "perPaymentLimit",
            "dailyLimit",
            "expiry"
          ],
          "additionalProperties": false,
          "properties": {
            "chainId": {
              "$ref": "#/$defs/uint"
            },
            "contract": {
              "$ref": "#/$defs/hex20"
            },
            "perPaymentLimit": {
              "$ref": "#/$defs/uint"
            },
            "dailyLimit": {
              "$ref": "#/$defs/uint"
            },
            "expiry": {
              "$ref": "#/$defs/uint"
            }
          }
        }
      }
    },
    "setup.timeAnchor": {
      "direction": "operator tool to device (BLE setup session)",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "device",
        "timestamp",
        "operatorSignature"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "setup.timeAnchor"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "timestamp": {
          "$ref": "#/$defs/uint"
        },
        "operatorSignature": {
          "$ref": "#/$defs/signature"
        },
        "device": {
          "$ref": "#/$defs/hex20"
        }
      }
    },
    "error": {
      "direction": "either",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "reason"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "error"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    },
    "session.cancel": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "session.cancel"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        }
      },
      "description": "sent when no signature arrives within 10 s; the device stops waiting for the button and signs nothing"
    },
    "payment.outcome": {
      "direction": "kiosk to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "orderId",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "payment.outcome"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "orderId": {
          "$ref": "#/$defs/hex32"
        },
        "outcome": {
          "enum": [
            "approved",
            "refused",
            "failed",
            "Checking"
          ]
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      },
      "description": "final kiosk outcome; the device shows it with LEDs and forwards it to the phone app"
    },
    "limit.result": {
      "direction": "device to kiosk",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "outcome"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "limit.result"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "outcome": {
          "enum": [
            "approved",
            "refused"
          ]
        },
        "signature": {
          "$ref": "#/$defs/signature"
        },
        "nonce": {
          "$ref": "#/$defs/uint"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "approved"
              }
            }
          },
          "then": {
            "required": [
              "signature",
              "nonce"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "refused"
              }
            }
          },
          "then": {
            "required": [
              "reason"
            ]
          }
        }
      ]
    },
    "setup.operator": {
      "direction": "operator tool to device (setup session)",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "operator",
        "contract",
        "chainId",
        "passkey"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "setup.operator"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "operator": {
          "$ref": "#/$defs/hex20"
        },
        "contract": {
          "$ref": "#/$defs/hex20"
        },
        "chainId": {
          "$ref": "#/$defs/uint"
        },
        "passkey": {
          "$ref": "#/$defs/uint",
          "description": "per-device LE Secure Connections passkey, 0 to 999999 (printed as six digits on the label QR)"
        }
      },
      "description": "accepted only in UNPROVISIONED state after the renter confirms on the device button; the device stores these values together with the new key and PIN"
    },
    "setup.ack": {
      "direction": "device to operator tool",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "step",
        "accepted"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "setup.ack"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "step": {
          "enum": [
            "setup.operator",
            "keygen",
            "setup.timeAnchor",
            "device.reset"
          ]
        },
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "$ref": "#/$defs/reason"
        },
        "device": {
          "$ref": "#/$defs/hex20"
        },
        "lastAnchor": {
          "$ref": "#/$defs/uint"
        }
      },
      "description": "sent after each setup step; after setup.operator the device sends the setup.operator ack on the button press and the keygen ack once the key and PIN exist, which carries the new device address that the operator tool signs into TimeAnchor"
    },
    "device.reset": {
      "direction": "operator tool to device",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "device",
        "nonce",
        "operatorSignature"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "device.reset"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "device": {
          "$ref": "#/$defs/hex20"
        },
        "nonce": {
          "$ref": "#/$defs/uint"
        },
        "operatorSignature": {
          "$ref": "#/$defs/signature"
        }
      },
      "description": "operator-signed DeviceReset; wipes key, PIN, operator address, contract, TimeAnchor and nonce records"
    },
    "confirm.show": {
      "direction": "device to phone app",
      "type": "object",
      "required": [
        "v",
        "type",
        "sessionId",
        "merchantName",
        "orderId",
        "token",
        "payout",
        "amount"
      ],
      "additionalProperties": false,
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "confirm.show"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        },
        "merchantName": {
          "type": "string",
          "maxLength": 64
        },
        "orderId": {
          "$ref": "#/$defs/hex32"
        },
        "token": {
          "$ref": "#/$defs/hex20"
        },
        "payout": {
          "$ref": "#/$defs/hex20"
        },
        "amount": {
          "$ref": "#/$defs/uint"
        }
      },
      "description": "payment fields the device is about to sign, sent over the bonded phone-app link; the app shows only these values and has no approve button"
    }
  },
  "w12AgreedCodes": [
    "ATTESTATION_EXPIRED",
    "MERCHANT_REVOKED",
    "OVER_CAP",
    "NONCE_REPLAYED",
    "MERCHANT_FORGED"
  ]
}
