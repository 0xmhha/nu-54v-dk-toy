    "API020Response": {
      "type": "object",
      "properties": {
        "statusCode": {
          "const": 202
        },
        "body": {
          "type": "object",
          "properties": {
            "requestId": {
              "$ref": "urn:nu:integration:baseline#/$defs/Id"
            },
            "data": {
              "type": "object",
              "properties": {
                "operation": {
                  "$ref": "urn:nu:approval:baseline#/$defs/Operation"
                },
                "approval": {
                  "anyOf": [
                    {
                      "$ref": "urn:nu:integration:common#/$defs/ApprovalProjection"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operationClass": {
                  "enum": [
                    "approval_parent",
                    "approval_child",
                    "general"
                  ]
                },
                "approvalOperationId": {
                  "anyOf": [
                    {
                      "$ref": "urn:nu:integration:baseline#/$defs/Id"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "operation",
                "approval",
                "operationClass",
                "approvalOperationId"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "operationClass": {
                        "enum": [
                          "approval_parent",
                          "approval_child"
                        ]
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "operation": {
                        "properties": {
                          "resultRef": {
                            "type": "null"
                          }
                        }
                      },
                      "approvalOperationId": {
                        "$ref": "urn:nu:integration:baseline#/$defs/Id"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operationClass": {
                        "const": "approval_parent"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "approval": {
                        "type": "object"
                      }
                    }
                  },
                  "else": {
                    "properties": {
                      "approval": {
                        "type": "null"
                      }
                    }
                  }
                },
                {
                  "if": {
                    "properties": {
                      "operationClass": {
                        "const": "general"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "approvalOperationId": {
                        "type": "null"
                      }
                    }
                  }
                }
              ]
            }
          },
          "required": [
            "requestId",
            "data"
