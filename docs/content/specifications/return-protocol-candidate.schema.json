        },
        "holderProof": {
          "$ref": "#/$defs/Proof"
        },
        "protectedEvidence": {
          "$ref": "#/$defs/ProtectedEvidence"
        }
      },
      "required": [
        "protocolVersion",
        "purpose",
        "audience",
        "requestId",
        "idempotencyKey",
        "jobId",
        "authority",
        "requestChallenge",
        "holderProof",
        "protectedEvidence"
      ],
      "additionalProperties": false
