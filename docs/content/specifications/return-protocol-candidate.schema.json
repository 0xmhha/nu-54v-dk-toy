          "type": "boolean"
        },
        "currentDeviceEpochMatches": {
          "type": "boolean"
        },
        "deviceEnrollmentState": {
          "type": "string",
          "enum": [
            "awaiting_cleanup",
            "unprovisioned_ready",
            "assigned",
            "quarantined"
          ]
        },
        "reuseGate": {
          "type": "string",
          "enum": [
            "closed",
            "awaiting_cleanup",
            "eligible"
          ]
        },
        "gateRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "jobId",
        "deviceId",
        "nextEpoch",
        "serverReturnCompleted",
        "cleanupVerified",
        "currentDeviceEpochMatches",
        "deviceEnrollmentState",
        "reuseGate",
        "gateRevision"
      ],
      "additionalProperties": false
    },
    "JobProgress": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "checking",
            "prepared",
            "commit_issued",
            "device_started",
            "evidence_pending",
            "completed",
            "aborted",
            "quarantined"
          ]
        },
        "grantIssued": {
          "type": "boolean"
        },
        "jobRevision": {
          "type": "integer",
          "minimum": 0
        },
        "reuseGate": {
          "type": "string",
          "enum": [
            "closed",
            "awaiting_cleanup",
            "eligible"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "recovery_policy_unresolved",
              "checks_pending",
              "prepare_stale",
              "execution_unknown",
              "proof_invalid",
              "cleanup_pending",
              "marker_missing",
              "epoch_mismatch"
            ]
          },
          "uniqueItems": true
        }
      },
      "required": [
        "jobId",
        "phase",
        "grantIssued",
        "jobRevision",
        "reuseGate",
        "reasonCodes"
      ],
      "additionalProperties": false
    },
    "OwnerJobStatus": {
      "type": "object",
      "properties": {
        "projection": {
          "const": "owner"
        },
        "progress": {
          "$ref": "#/$defs/JobProgress"
        },
        "rentalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "checklistRevision": {
          "type": "integer",
          "minimum": 0
        },
        "lateAssetRecovery": {
          "type": "string",
          "enum": [
            "unresolved",
            "verified_external_access",
            "verified_recovery_profile",
            "not_verified"
          ]
        }
      },
      "required": [
        "projection",
        "progress",
        "rentalId",
        "checklistRevision",
        "lateAssetRecovery"
      ],
      "additionalProperties": false
    },
    "OperatorJobStatus": {
      "type": "object",
      "properties": {
        "projection": {
          "const": "operator_safe"
        },
        "progress": {
          "$ref": "#/$defs/JobProgress"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        }
      },
      "required": [
        "projection",
        "progress",
        "deviceId"
      ],
      "additionalProperties": false
    },
    "JobStatus": {
      "oneOf": [
        {
          "$ref": "#/$defs/OwnerJobStatus"
        },
        {
          "$ref": "#/$defs/OperatorJobStatus"
        }
      ]
    },
    "ProtocolError": {
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "code": {
          "type": "string",
          "enum": [
            "REVISION_CONFLICT",
            "RECOVERY_POLICY_UNRESOLVED",
            "PREPARE_EXPIRED",
            "GRANT_ALREADY_ISSUED",
            "JOB_SCOPE_MISMATCH",
            "AUTHORITY_SCOPE_DENIED",
            "PROOF_PROFILE_UNSUPPORTED",
            "PROOF_INVALID",
            "EPOCH_MISMATCH",
            "MARKER_MISSING",
            "VERIFICATION_PENDING"
          ]
        },
        "retryAction": {
          "type": "string",
          "enum": [
            "refresh_job",
            "reauthenticate_relay",
            "repeat_same_request",
            "await_verification",
            "quarantine_review",
            "none"
          ]
        },
        "safeJobRef": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,128}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "requestId",
        "code",
        "retryAction",
        "safeJobRef"
      ],
      "additionalProperties": false
    }
  }
}
