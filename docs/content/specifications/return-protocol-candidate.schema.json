        "reuseGate": {
          "type": "string",
          "enum": [
            "closed",
            "awaiting_cleanup",
            "eligible"
          ]
        },
        "completionAck": {
          "anyOf": [
            {
              "$ref": "#/$defs/CompletionAck"
