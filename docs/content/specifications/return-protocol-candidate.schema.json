      "required": [
        "protocolVersion",
        "purpose",
        "audience",
        "authorityId",
        "jobId",
        "deviceId",
        "epoch",
        "holderKeyThumbprint",
        "allowedActions",
        "expiresAt",
        "authorizationRevision"
