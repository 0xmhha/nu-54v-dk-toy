    "ResetEvidencePayload": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "return-candidate-1"
        },
        "purpose": {
          "const": "reset_execution_report"
        },
        "audience": {
          "const": "reset_evidence_verifier"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "commitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "grantDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "preparationDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "nextEpoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
