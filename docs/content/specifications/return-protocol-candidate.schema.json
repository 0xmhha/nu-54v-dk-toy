        }
      },
      "required": [
        "issuanceOutcome",
        "grant",
        "grantDigest",
        "deliveryAdvice"
      ],
      "additionalProperties": false
    },
    "AuthorityPayload": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "return-candidate-1"
        },
        "purpose": {
          "const": "reset_recovery_relay"
        },
        "audience": {
          "const": "reset_recovery_gateway"
        },
        "authorityId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "epoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "holderKeyThumbprint": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "relay_evidence",
              "relay_completion_ack",
              "request_cleanup_proof",
              "submit_cleanup_proof",
              "read_job_progress"
            ]
          },
          "uniqueItems": true
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorizationRevision": {
          "type": "integer",
          "minimum": 0
