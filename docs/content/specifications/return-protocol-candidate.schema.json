      "additionalProperties": false
    },
    "PrepareReportPayload": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "return-candidate-1"
        },
        "purpose": {
          "const": "reset_prepare_report"
        },
        "audience": {
          "const": "reset_coordinator"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "preparation": {
          "$ref": "#/$defs/Preparation"
        },
        "ownerApprovalDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "journalAccepted": {
          "const": false
