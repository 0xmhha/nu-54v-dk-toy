      },
      "required": [
        "protocolVersion",
        "purpose",
        "audience",
        "binding",
        "preparation",
        "ownerApprovalDigest",
        "journalAccepted"
      ],
      "additionalProperties": false
    },
    "PrepareReport": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/PrepareReportPayload"
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        }
      },
      "required": [
        "payload",
        "proof"
      ],
      "additionalProperties": false
    },
    "CommitRequest": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "return-candidate-1"
        },
        "purpose": {
          "const": "request_reset_execution"
        },
        "audience": {
          "const": "reset_coordinator"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "idempotencyKey": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "clearanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "prepareReport": {
          "$ref": "#/$defs/PrepareReport"
        }
      },
      "required": [
        "protocolVersion",
        "purpose",
        "audience",
        "requestId",
        "idempotencyKey",
        "binding",
        "clearanceId",
        "prepareReport"
      ],
      "additionalProperties": false
    },
    "ExecutionGrantPayload": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "return-candidate-1"
        },
        "purpose": {
          "const": "reset_execute"
        },
        "audienceDeviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "binding": {
          "$ref": "#/$defs/Binding"
        },
        "commitId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "clearanceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "preparation": {
          "$ref": "#/$defs/Preparation"
        },
        "ownerApprovalDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "serverRecordedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "protocolVersion",
        "purpose",
        "audienceDeviceId",
        "binding",
        "commitId",
        "clearanceId",
        "preparation",
        "ownerApprovalDigest",
        "serverRecordedAt"
      ],
      "additionalProperties": false
    },
    "ExecutionGrant": {
      "type": "object",
      "properties": {
        "payload": {
          "$ref": "#/$defs/ExecutionGrantPayload"
        },
        "proof": {
          "$ref": "#/$defs/Proof"
        }
      },
      "required": [
        "payload",
        "proof"
      ],
      "additionalProperties": false
    },
    "CommitResult": {
      "type": "object",
      "properties": {
        "issuanceOutcome": {
          "type": "string",
          "enum": [
            "issued",
            "existing"
          ]
