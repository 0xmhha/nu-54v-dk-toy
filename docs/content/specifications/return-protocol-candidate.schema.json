        "grant": {
          "$ref": "#/$defs/ExecutionGrant"
        },
        "grantDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "deliveryAdvice": {
          "type": "string",
          "enum": [
            "same_live_preparation_only",
            "do_not_deliver",
            "already_journaled"
