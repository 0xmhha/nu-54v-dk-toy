{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nu:return:protocol:candidate:1",
  "title": "Logical return protocol review candidate; not BLE wire or live HTTP contract",
  "$defs": {
    "Id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,128}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0
    },
    "Epoch": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "Proof": {
      "type": "object",
      "properties": {
        "profileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "signedDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "proofBytes": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "maxLength": 8192
        }
      },
      "required": [
        "profileId",
        "keyId",
        "signedDigest",
        "proofBytes"
      ],
      "additionalProperties": false
    },
    "Binding": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "deviceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "rentalId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "previousBindingId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "previousEpoch": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "checklistRevision": {
          "type": "integer",
          "minimum": 0
        },
        "fenceRevision": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "jobId",
        "deviceId",
        "rentalId",
        "previousBindingId",
        "previousEpoch",
        "checklistRevision",
        "fenceRevision"
      ],
      "additionalProperties": false
    },
    "Preparation": {
      "type": "object",
      "properties": {
        "prepareId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "bootNonce": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "sessionId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "challengeDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "eraseProfileId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,128}$"
        },
        "deviceElapsedLimitMs": {
          "type": "integer",
          "minimum": 1
        },
        "preparationDigest": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      },
      "required": [
        "prepareId",
        "bootNonce",
        "sessionId",
        "challengeDigest",
        "eraseProfileId",
        "deviceElapsedLimitMs",
        "preparationDigest"
