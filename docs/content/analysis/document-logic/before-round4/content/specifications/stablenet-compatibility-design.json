  "indexerStages": [
    {
      "id": "IX-01",
      "stage": "환경/배포 확인",
      "rule": "CM01/03의 신원·checkpoint/code/권한 검증 후 source 등록. 체인 mismatch면 affected ingestion/새승인 hold",
      "output": "검증된 environment/deployment revision"
    },
    {
      "id": "IX-02",
      "stage": "원시 관측 보존",
      "rule": "block hash/parent·tx receipt/log와 원천 range를 보존. subscription은 알림이며 canonical range 재조회가 기준",
      "output": "observationId=(environment,blockHash,txHash,logIndex), native/trace는 별도 typed key"
    },
    {
      "id": "IX-03",
      "stage": "누락/재구성 탐지",
      "rule": "cursor의 hash ancestry 대조, 공통조상까지 검증 후 새 branch 읽기. finality 가정 밖 재구성은 격리·전체영향검토",
      "output": "contiguous complete range; highest block만으로 checkpoint 전진 금지"
    },
    {
      "id": "IX-04",
      "stage": "버전별 decoding",
      "rule": "배포주소/code/proxy upgrade position에 맞는 ABI/decoder 적용. 같은 block의 upgrade 전후 순서 불명하면 해당범위 hold",
      "output": "immutable decode version + 원 raw digest + decoded/unsupported/invalid 상태"
    },
    {
      "id": "IX-05",
      "stage": "실행 귀속",
      "rule": "EOA tx와 UserOp를 구분하고 expected payload/실제 log를 결합. 동일 bundle 내 매칭 모호하면 hold",
      "output": "source execution ref와 exact evidence mapping; timestamp/amount만으로 연결 금지"
    },
    {
      "id": "IX-06",
      "stage": "업무 대사",
      "rule": "현재 canonicality/confirmation/원 policy와 원 주문·환불 provenance 검사; shared gate와 funding hold 원자변경",
      "output": "기존 allocation/effect identity 유지, observation revision 한번 적용; chain 이벤트가 주문승인을 대체하지 않음"
    },
    {
      "id": "IX-07",
      "stage": "조회 projection",
      "rule": "source cut/authorityEpoch/completeness/ownership를 확인해 consumer별 기여분과 generation 반영",
      "output": "앱 asOf/freshness/held와 cursor; stale/unknown을 0/failed로 변환 금지"
    },
    {
      "id": "IX-08",
      "stage": "decoder 교체·재처리",
      "rule": "새 decoder로 shadow build/diff→검토→현재권한/source/generation/fence 재확인→단일consumer atomic publish",
      "output": "기존 CP-B06 준수; raw 이력/원마감 보존, 재처리로 신규지급/보상/환불 생성 금지"
    }
  ],
