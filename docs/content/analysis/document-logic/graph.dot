  "trust:TP-01" [label="TP-01 bootstrap의 out-of-band 신뢰 출처·초기 승인자 독립 통제·설치 evidence 형식"];
  "trust:TP-02" [label="TP-02 관리 key purpose별 suite·keyId·PoP/challenge·정규화·승인 수/독립성 규칙"];
  "trust:TP-03" [label="TP-03 anchor/checkpoint/boot counter·최대 관측 epoch의 보호 저장과 restore 판정 경로"];
  "trust:TP-04" [label="TP-04 사전 recovery authority·독립 복구 증거·비밀 보관/분실·격리 절차"];
  "trust:TP-05" [label="TP-05 관리 key/grant 유효시간·rotation overlap·cache/lease·철회 전달 한계"];
  "trust:TP-06" [label="TP-06 감사·사건 기록 보존, DB restore 검증과 현재 fence/grant 복원 기준"];
  "trust:TR-01" [label="TR-01 BootstrapEvidence"];
  "trust:TR-02" [label="TR-02 TrustAnchorVersion"];
  "trust:TR-03" [label="TR-03 ManagementKeyBinding"];
  "trust:TR-04" [label="TR-04 TrustApprovalEvidence"];
  "trust:TR-05" [label="TR-05 TrustRecoveryCase"];
  "trust:TR-06" [label="TR-06 ConsumerTrustCheckpoint"];
  "trust:TR-07" [label="TR-07 TrustRestoreAssessment"];
  "trust:TI-01" [label="TI-01 초기 신뢰는 대상 bundle 밖에서 확인한다. 빈 DB/자기 서명/new root PoP만으로 bootstrap하지 않는다."];
  "trust:TI-02" [label="TI-02 권한 상승 요청자·승인자와 승인 key/control identity를 중복 계산하지 않으며 quorum을 단순 서명 개수로 대체하지 않는다."];
  "trust:TI-03" [label="TI-03 승인한 exact digest/scope/expected revisions와 commit 값이 동일해야 한다. 변경된 본문은 재승인 대상이다."];
  "trust:TI-04" [label="TI-04 새 키 PoP와 키를 관리자 권한에 연결할 권한은 별도이다. 목적·scope가 바뀌면 단순 키 교체로 처리하지 않는다."];
  "trust:TI-05" [label="TI-05 이전 root의 권한·새 root의 증거·연속 epoch를 모두 확인한 정상 교체와 독립 recovery path를 혼용하지 않는다."];
  "trust:TI-06" [label="TI-06 현재 grant/fence/anchor/approval expiry가 과거 승인 snapshot보다 우선한다. 결과 재조회가 revoked grant를 복구하지 않는다."];
  "trust:TI-07" [label="TI-07 bootstrap ticket/recovery case는 단회 commit한다. 결과 불명·cache 만료·다른 relay를 재사용 허가로 보지 않는다."];
  "trust:TI-08" [label="TI-08 복구 후 기본 상태는 제한 유지이며 이전 fence/epoch를 낮추지 않는다. 기능 재개는 별도 현재 근거가 필요하다."];
  "trust:TI-09" [label="TI-09 rollback된 DB/기기 snapshot의 epoch·grant를 current로 추정하지 않는다. 독립 checkpoint 검증 불가 시 새 민감 동작은 격리한다."];
  "trust:TI-10" [label="TI-10 관리 키 침해·복구가 사용자 signer/backup/asset 권한을 생성하지 않는다. 원 거래 관측은 현재 업무 권한으로 별도 유지한다."];
