  "trustops:TOE-01" [label="TOE-01 승인/독립 복구 주체가 목적에 맞게 발급. 앱은 증거를 중계하며 발급자 서명을 대신하지 않는다."];
  "trustops:TOE-02" [label="TOE-02 요청자가 변경안을 작성하고 서비스가 정규화 본문·digest를 확정. 승인자는 그대로 읽고 승인한다."];
  "trustops:TOE-03" [label="TOE-03 원 승인별 유효성·독립성을 집계한 파생 기록. 집계 결과를 새 승인으로 세지 않는다."];
  "trustops:TOE-04" [label="TOE-04 선택된 신뢰 경로의 challenge 발급과 원 요청별 예약/소비. 브라우저 생성 난수만으로 유효 challenge를 대체하지 않는다."];
  "trustops:TOE-05" [label="TOE-05 검증 시점의 영수증. commit 서비스는 현재성을 재확인하며 과거 영수증으로 재승인하지 않는다."];
  "trustops:TOE-06" [label="TOE-06 효과의 권위 있는 commit 근거에 따라 원 결과 기록. unknown은 추측으로 성공/실패 확정하지 않는다."];
  "trustops:TOE-07" [label="TOE-07 삭제 계획의 대상/revision과 의존성 검토 기록. 실제 폐기는 보관 서비스가 최신 계획을 검사하고 수행한다."];
