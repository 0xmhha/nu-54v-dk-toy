  "authRecoveryRules": {
    "refreshConflict": "같은 family/generation에서 다른 request가 경합하면 CAS 승자만 회전. 패자는 새 token을 받지 않는다. 검증된 재사용/탈취 신호에 따른 family hold 정책과 단순 병렬경합을 분리한다.",
    "idempotency": "보호 결과 보관 TTL과sender proofprofile은 선택 입력. 안전 재전달을 증명하지 못하면 restart_required, 이전 bearer만으로 최신token 공개 금지.",
    "unlinkConcurrency": "마지막 접근수단 보존 검사를 account-level lock/revision 아래에서 수행. 서로 다른 identity unlink 두 건이 개별 검사만 통과해 모두 삭제되는 경우 금지.",
    "scope": "OC17..20은 논리 계약 후보이며 기존 API020/107 dispatch 등록으로 간주하지 않음. 현재 카탈로그/ACL/보호 결과 reader는 채택 전 지원불가를 반환해야 한다."
  },
  "refreshResultPolicy": {
    "priority": [
      "caller_bound_proof",
      "family_session_epoch",
      "result_generation",
      "result_material_lifetime"
    ],
    "rules": [
      {
        "id": "RR-01",
        "condition": "caller proof 또는 operation binding 불일치",
        "state": "forbidden",
        "returnToken": false
      },
      {
        "id": "RR-02",
        "condition": "family/session revoked 또는 epoch 불일치",
        "state": "revoked",
        "returnToken": false
      },
      {
        "id": "RR-03",
        "condition": "resultGeneration < currentFamilyGeneration",
        "state": "superseded",
        "returnToken": false
      },
      {
        "id": "RR-04",
        "condition": "resultGeneration > currentFamilyGeneration",
        "state": "held",
        "returnToken": false
      },
      {
        "id": "RR-05",
        "condition": "세대 동일하지만 보호 결과 만료 또는 복구 sender 상실",
        "state": "restart_required",
        "returnToken": false
      },
      {
        "id": "RR-06",
        "condition": "세대 동일·현재권한·epoch·유효보호결과와sender proof 모두 확인",
        "state": "rotated",
        "returnToken": true
      }
    ],
    "clientRule": "응답의 family/epoch/generation을 현재 local state와 CAS 비교한다. 더 낮은 generation 또는 logout epoch의 늦은 응답은 설치하지 않는다. 조회는 회전 작업이 아니므로 재사용 공격으로 자동 집계하지 않는다.",
    "pending": "아직 회전 결과가 없으면 현재 권한 확인 후 pending metadata만. tokenRef/token bytes 없음."
  }
}
