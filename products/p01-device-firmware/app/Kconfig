# P01 application options.

config NU54_DEV_SETUP
	bool "Week-7 fixed setup when no rental setup is stored"
	default y
	help
	  Without a stored rental setup, create the device key at boot and use the operator,
	  settlement contract and chain id from the deployment record (week-7 gate). Turn it off
	  for the rental build: the device then boots UNPROVISIONED and waits for a setup session.

config NU54_DEV_UNPAIRED_ANCHOR
	bool "Take a TimeAnchor from the unpaired kiosk (development)"
	default y
	help
	  A provisioned device opens a setup session from a central that is not bonded, so the kiosk
	  can hand over a TimeAnchor its development anchor server signed (session vector SV-34).
	  setup.operator still needs a bonded session. The release build turns it off: anchors then
	  come from the operator tool on a bonded link.

config NU54_REQUIRE_SECURE_SESSION
	bool "Refuse plaintext payment sessions"
	help
	  Payment sessions must open the secure channel (payment-protocol.md 4.1); a plaintext
	  session.open in payment mode is answered with error NOT_PERMITTED. The release build turns
	  it on once the kiosk has the channel; development builds keep plaintext for the week-7 path.

config NU54_REQUIRE_PHONE
	bool "Refuse payments and limit changes with no phone app listening"
	help
	  The renter checks what the device signs on the bonded phone app (payment-protocol.md 3).
	  With this on, payment.prepare and limit.change are refused NOT_PERMITTED when no phone app
	  is listening. Development builds go on without one (week-7 path, N30).

config NU54_PILOT_TLS
	bool "Compile the certificate-only TLS 1.3 board adapter"
	select MBEDTLS_TLS_LIBRARY
	help
	  Build the native v2 TLS adapter for installation-time enrollment.
	  Activation needs explicitly provisioned credentials and a trusted policy.

config NU54_INSTALL_AUTHORITY_HEX
	string "Enrollment authority P-256 public point (uncompressed SEC1 in hex)"
	depends on NU54_PILOT_TLS
	default ""
	help
	  Pin the independently managed enrollment authority in the installation image.
	  A missing pin leaves runtime enrollment unavailable. Never include a private key.

config NU54_HD_RECOVERY
	bool "Independent offline HD recovery provider"
	depends on NU54_PILOT_TLS
	select PSA_WANT_ALG_SHA_512
	select PSA_WANT_ALG_CMAC
	help
	  Build the isolated recovery service for a separately enrolled laboratory accessory.

config NU54_WALLET_CHAINS
	bool "Bounded Bitcoin, Solana and XRP Ledger wallet profiles"
	depends on NU54_HD_RECOVERY
	select PSA_WANT_ALG_PURE_EDDSA
	select PSA_WANT_ECC_TWISTED_EDWARDS_255
	help
	  Activate authorized chain-specific review, secure seed derivation and signing.

config NU54_COMMISSIONED_WALLET_CHAINS
	bool "Commissioned public test-network wallet transfers"
	depends on NU54_WALLET_CHAINS
	help
	  Enable N54M profile 2 with fixed Signet, Devnet and XRPL Testnet identities.

config NU54_HD_KMU_SLOT
	int "Dedicated KMU seed commitment slot for the laboratory profile"
	depends on NU54_HD_RECOVERY
	range 32 127
	default 96

config NU54_COUNTED_UPDATE
	bool "Physically authorized wired firmware staging"
	depends on BOOTLOADER_MCUBOOT
	select REBOOT

config NU54_SPENDING_PROFILE
	bool "Screenless spending wallet for the 8283 test network"
	depends on NU54_PILOT_TLS && !NU54_HD_RECOVERY && !NU54_EXPERIMENTAL_OWNER_LIMITS_PSA
	default n
	help
	  The owner pays orders into OrderEscrow with the key the board generated itself. There is
	  no backup. The phone shows the amount and the store, so the physical prompt opens without
	  the independent display. The board still requires a testnet grant, the enrolled store's
	  signature, the per-payment and daily caps, SW1 and the PIN. Never enable it for real funds.

config NU54_SPENDING_DAILY_CAP
	int "Daily total the board signs, in asset base units"
	depends on NU54_SPENDING_PROFILE
	range 1 2000000000
	default 100000000

config NU54_OWNER_WAIT_ADV
	bool "Advertise by itself while the board has no owner"
	depends on NU54_PILOT_TLS
	default y if NU54_SPENDING_PROFILE
	help
	  A commercial board without an owner (new, or after a factory reset) advertises the owner
	  service by itself, so the next owner's phone finds it without a button. It starts fast and
	  goes on slowly to save the battery (core/nu54_adv_schedule.h). A connection alone opens
	  nothing: the board still asks for the operator's grant, SW1 and a new PIN. The enrollment
	  window stays on SW4. A board with an owner advertises only after a button, as before.

if NU54_OWNER_WAIT_ADV

config NU54_OWNER_WAIT_FAST_SECONDS
	int "Seconds of fast advertising after the board starts without an owner"
	range 0 300
	default 30
	help
	  0 starts with the slow interval. It may not be longer than the total time.

config NU54_OWNER_WAIT_TOTAL_SECONDS
	int "Seconds until a board without an owner stops advertising (0: never)"
	range 0 604800
	default 10800
	help
	  After this time the board is silent until SW4 is held. Longer finds the board later at the
	  cost of the battery; the budget is in board-secure-key-and-advertising.md.

config NU54_OWNER_WAIT_IDLE_SECONDS
	int "Seconds a board without an owner keeps a central that does nothing (0: no limit)"
	range 0 600
	default 30
	help
	  The board takes two centrals. One that connects and neither starts the installation
	  ticket nor a TLS session is disconnected after this time, counted from the connection or
	  from the end of its last attempt, so that idle centrals cannot keep both slots and hide
	  the board from the next owner and from the SW4 window. A ticket that was started
	  counts as an attempt for 15 seconds. A central that keeps starting attempts, or
	  keeps reconnecting, is not stopped by this: idle centrals are dropped, a central
	  that means to block the board is not.

config NU54_OWNER_WAIT_FAST_INTERVAL_MIN
	int "Shortest fast advertising interval, in 0.625 ms"
	range 32 16384
	default 160

config NU54_OWNER_WAIT_FAST_INTERVAL_MAX
	int "Longest fast advertising interval, in 0.625 ms"
	range NU54_OWNER_WAIT_FAST_INTERVAL_MIN 16384
	default 240

config NU54_OWNER_WAIT_SLOW_INTERVAL_MIN
	int "Shortest slow advertising interval, in 0.625 ms"
	range NU54_OWNER_WAIT_FAST_INTERVAL_MAX 16384
	default 1600

config NU54_OWNER_WAIT_SLOW_INTERVAL_MAX
	int "Longest slow advertising interval, in 0.625 ms"
	range NU54_OWNER_WAIT_SLOW_INTERVAL_MIN 16384
	default 1920

endif # NU54_OWNER_WAIT_ADV

config NU54_CLOCK_SAVE_SECONDS
	int "Seconds between two saves of the board's time while a grant runs"
	depends on NU54_SPENDING_PROFILE
	range 60 86400
	default 3600
	help
	  The spending profile keeps the operator's grant through a restart and continues from the
	  time it saved last. Each save is one write to protected storage. A restart loses what
	  passed since the last save, and the owner's phone sets the clock again at its next
	  session (the time command), so the interval does not decide whether payments work after
	  a restart. It decides how much of the grant's period a restart gives back in board time,
	  and how often the storage is written. The time is also saved when the phone moves it and
	  when the grant ends. One hour is 24 writes a day.

config NU54_CLOCK_SESSION_SECONDS
	int "Oldest session, in seconds, in which the owner's phone may still tell the time"
	depends on NU54_SPENDING_PROFILE
	range 1 60
	default 15
	help
	  The owner's phone tells a restarted board the time (the time command). The board counts
	  from the first byte of the TLS session, so the count includes the handshake. The phone
	  read its clock some time after that, so the board's latest possible time becomes the
	  phone's time plus the session's age plus five seconds. A message that arrives later than
	  this limit is answered with "too late in the session" and moves nothing: its time would
	  widen the board's interval by its age, and every request that has less than that left to
	  run would then be refused.

	  The default is a guess, set low on purpose. NOT MEASURED ON A BOARD: if the handshake over
	  Bluetooth takes longer than this on the real board, every time command is answered "too
	  late" and a restarted board stays late until the operator's next grant. Measure the time
	  from the first write to the answer of the time command on the board and set this to that
	  plus a margin. The upper bound keeps the widest interval the phone can leave (this plus
	  five seconds) under the 90 seconds of the phone's short requests.

source "Kconfig.zephyr"

config NU54_SECURE_KEY
	bool "Keep the spending wallet key in the TF-M secure side"
	default n
	depends on NU54_SPENDING_PROFILE && BUILD_WITH_TFM && TFM_PARTITION_CRYPTO
	depends on TFM_PARTITION_INTERNAL_TRUSTED_STORAGE && TFM_ITS_ENCRYPTED && !SECURE_STORAGE
	depends on MBEDTLS_PSA_CRYPTO_STORAGE_C
	help
	  The wallet key is generated and used by TF-M's crypto partition and stored in the
	  encrypted Internal Trusted Storage of the secure side (Arm TrustZone). The application
	  is the non-secure image and can ask for a signature, the public key or the key's
	  destruction, never for the key. Outside a TF-M build with encrypted storage and
	  persistent PSA keys the option does not take effect, and Kconfig only warns about
	  that: the build goes on. What stops such a build is the evidence check of
	  scripts/fw.py build --secure-key, which reads the generated configuration back.
	  Build-verified only; see app/secure-key.conf.

config NU54_EXPERIMENTAL_PMIC_VIN_READ
	bool "Read qualified NU-54DK-C PMIC input status"
	depends on NU54_PILOT_TLS && BOARD_NU54V_DK && I2C && GPIO
	default n
	help
	  Use only with a qualified BQ25186 and assembled SB2 connection.
	  Exposes a read-only VIN observation, with no update authorization.

config NU54_EXPERIMENTAL_RENTAL_JOURNAL_PS
    bool "Compile experimental rollback-protected rental journal"
    default n
    depends on TRUSTED_EXECUTION_NONSECURE && TFM_PARTITION_PROTECTED_STORAGE && TFM_PS_ROLLBACK_PROTECTION
    help
      Compile the protected journal adapter for qualification. The legacy
      setup path cannot activate this journal. Real measured boot, secure
      registration and independent anti-rollback qualification are required.

config NU54_EXPERIMENTAL_OWNER_LIMITS_PSA
    bool "Compile experimental TF-M owner-limit storage port"
    default n
    depends on TRUSTED_EXECUTION_NONSECURE && TFM_PARTITION_PROTECTED_STORAGE && TFM_PS_ROLLBACK_PROTECTION
    help
      Compile-only port for qualification. It does not connect to signing or
      enable policy mutation. Production requires independently verified secure
      boot, provisioned keys and rollback-protected TF-M platform counters.

config NU54_EXPERIMENTAL_OWNER_FINALITY_ONLY
    bool "Use qualified 8283 finality-only owner policy mode"
    default n
    depends on NU54_EXPERIMENTAL_OWNER_LIMITS_PSA
    help
      Compile an isolated personal EVM signing mode. Other personal payment and
      chain-signing routes remain unavailable. This does not provision a key or
      qualify storage, firmware anti-downgrade, time, or independent finality.

config NU54_EXPERIMENTAL_W27_QUALIFICATION
    bool "Read experimental W27 TF-M platform observations"
    default n
    depends on NU54_EXPERIMENTAL_OWNER_LIMITS_PSA && SOC_NRF54L15 && TFM_IPC && TFM_ISOLATION_LEVEL = 1
    help
      Compile the read-only Nordic qualification service and client. Its
      evidence is incomplete and cannot enable the owner limits or signing.
