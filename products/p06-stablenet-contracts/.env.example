# P06 deployment settings. No keys or passwords here [N07][N25][N32].
NU54_RPC_URL=http://127.0.0.1:8545
NU54_TESTNET_RPC_URL=https://api.test.stablenet.network/
# Role keystores created by script/testnet-accounts.sh live outside the repository.
# secretRef = keystore path + password; the password stays in the macOS Keychain
# (service nu54-<role>) and reaches forge through script/testnet-forge.sh.
NU54_HOME=$HOME/.nu54
NU54_DEPLOYER_KEYSTORE=$HOME/.nu54/keystores/nu54-deployer
# Public role addresses written by the script:
#   source $HOME/.nu54/testnet-accounts.env
